# JitsiMap app server (SPEC §12.2) — TEMPLATE: docker/entrypoint.sh renders
# ${CSP} from JITSI_DOMAIN at container start, output: /etc/nginx/nginx.conf.
# Unprivileged: port 8080.

pid /tmp/nginx.pid;
worker_processes auto;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;

    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;

    sendfile on;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    server {
        listen 8080;
        listen [::]:8080;
        server_name _;
        root /usr/share/nginx/html;
        index index.html;

        # §14: restrictive CSP; connect-src allows the configured Jitsi domain
        # (WebSocket + BOSH). Blocking WSS is a release blocker (§16.3).
        # Rendered by docker/entrypoint.sh into the snippet below; the
        # snippet is included in every location that sets its own headers
        # (nginx add_header does NOT cascade into such locations).
        include /etc/nginx/snippets/security-headers.conf;

        # §12.2 healthcheck
        location = /healthz {
            include /etc/nginx/snippets/security-headers.conf;
            default_type text/plain;
            add_header Cache-Control "no-store" always;
            return 200 "ok";
        }

        # §12.3 runtime config: rendered at container start; NEVER cached,
        # and NO SPA fallback (a 404 here is a deployment bug the app surfaces).
        location = /config.json {
            include /etc/nginx/snippets/security-headers.conf;
            default_type application/json;
            add_header Cache-Control "no-store" always;
            try_files $uri =404;
        }

        location = /index.html {
            include /etc/nginx/snippets/security-headers.conf;
            add_header Cache-Control "no-cache" always;
        }

        # Maps are data: hashed-asset long cache below, maps cache 1h.
        # .tmj must serve as JSON (default_type override).
        location /maps/ {
            include /etc/nginx/snippets/security-headers.conf;
            types { }
            default_type application/json;
            add_header Cache-Control "public, max-age=3600" always;
        }
        location ~* \.(png|jpg|jpeg|gif|webp|svg)$ {
            include /etc/nginx/snippets/security-headers.conf;
            add_header Cache-Control "public, max-age=3600" always;
        }
        location /assets/ {
            include /etc/nginx/snippets/security-headers.conf;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
        }

        # SPA fallback: /, /s/<space>, ?map=...
        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
